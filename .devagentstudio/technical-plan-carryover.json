{
  "schemaVersion": 1,
  "sourceBranch": "v1_0",
  "plan": {
    "artifact_type": "technical-plan",
    "architecture": {
      "frontend": "基于单页应用生成页面、路由和 API 客户端。",
      "backend": "后端技术栈固定为 Java8 + Springboot，提供真实 HTTP API、资源接口和业务契约实现。",
      "data": "数据库固定使用 MySQL8，缓存固定使用 Redis。"
    },
    "entities": [
      {
        "id": "personnel_detail",
        "name": "人员明细",
        "description": "记录人员的基本明细信息，用于在只读列表中分页查看。",
        "fields": [
          {
            "label": "姓名（唯一标识）",
            "description": "人员姓名，每条记录都有值且在人员明细内保持唯一。",
            "name": "name",
            "type": "text",
            "required": true
          },
          {
            "label": "性别",
            "description": "人员性别。",
            "name": "gender",
            "type": "enum",
            "required": false,
            "enum_values": [
              "男",
              "女",
              "未知"
            ]
          },
          {
            "label": "年龄",
            "description": "人员年龄，非负整数。",
            "name": "age",
            "type": "number",
            "required": false
          },
          {
            "label": "联系电话",
            "description": "人员联系电话号码。",
            "name": "phone",
            "type": "text",
            "required": false
          },
          {
            "label": "电子邮箱",
            "description": "人员电子邮箱地址。",
            "name": "email",
            "type": "text",
            "required": false
          },
          {
            "label": "所属部门",
            "description": "人员所属部门名称。",
            "name": "department",
            "type": "text",
            "required": false
          },
          {
            "label": "职位",
            "description": "人员在组织中的职位名称。",
            "name": "position",
            "type": "text",
            "required": false
          },
          {
            "label": "入职日期",
            "description": "人员入职日期。",
            "name": "entry_date",
            "type": "date",
            "required": false
          },
          {
            "label": "备注",
            "description": "人员明细的补充说明信息。",
            "name": "remark",
            "type": "long_text",
            "required": false
          }
        ]
      }
    ],
    "api_contracts": [
      {
        "id": "personnel_detail_contract",
        "name": "人员明细",
        "base_path": "/personnel-details",
        "authentication": {
          "required": false
        },
        "schemas": {
          "PageResult": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "current": {
                "type": "integer",
                "minimum": 1
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1
              },
              "list": {
                "type": "array",
                "items": {
                  "$ref": "PersonnelDetailListItem"
                }
              }
            },
            "required": []
          },
          "PersonnelDetailListItem": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "gender": {
                "type": "string",
                "enum": [
                  "男",
                  "女",
                  "未知"
                ]
              },
              "age": {
                "type": "integer",
                "minimum": 0
              },
              "email": {
                "type": "string"
              },
              "department": {
                "type": "string"
              },
              "position": {
                "type": "string"
              },
              "entryDate": {
                "type": "string"
              },
              "remark": {
                "type": "string"
              }
            },
            "required": []
          }
        },
        "endpoints": [
          {
            "id": "personnel_detail_contract.listPersonnelDetails",
            "name": "分页查询人员明细",
            "method": "GET",
            "path": "/personnel-details",
            "summary": "分页查询人员明细列表，支持按页码和每页条数浏览；返回人员姓名、性别、年龄、电子邮箱、所属部门、职位、入职日期和备注等明细信息。列表分页。",
            "parameters": [
              {
                "name": "current",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                }
              },
              {
                "name": "pageSize",
                "in": "query",
                "required": false,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 20
                }
              }
            ],
            "request_schema_ref": null,
            "response_schema_ref": "PageResult",
            "error_codes": [],
            "authentication": {
              "required": false
            }
          }
        ],
        "entity_ids": [
          "personnel_detail"
        ]
      }
    ],
    "pages": [
      {
        "pageId": "personnel_detail_list",
        "references": {
          "endpoint_dependencies": [
            {
              "endpoint_id": "personnel_detail_contract.listPersonnelDetails",
              "usage": "分页查询人员明细列表，返回当前页人员明细数据及分页信息",
              "trigger": "初始加载页面时查询第一页人员明细；切换分页时按所选页码查询对应页人员明细",
              "required_for_initial_load": true
            }
          ],
          "action_implementations": [
            {
              "actionId": "change_page",
              "endpointId": "personnel_detail_contract.listPersonnelDetails"
            }
          ]
        }
      }
    ],
    "authorization_manifest": {
      "schema_version": "authorization-manifest.v3",
      "resources": [],
      "bindings": {
        "pages": [],
        "actions": [],
        "endpoints": []
      },
      "systemAuthorization": {
        "adminRoleSeedKey": "",
        "managementResourceKey": ""
      },
      "defaultRoleAuthorization": {
        "roles": [],
        "roleResourceGrants": []
      },
      "fingerprint": "sha256:322b4621177476bce45b77aeec3acf6bf4bb9ae05e952dcb8e69b82efbb03adc"
    },
    "sourceConfigRevision": 2
  }
}
