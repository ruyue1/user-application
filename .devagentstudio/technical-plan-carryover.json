            "required": true
          },
          {
            "label": "员工编号",
            "description": "门禁卡领用申请明细所属员工的员工编号，用于标识员工身份。",
            "name": "employee_no",
            "type": "text",
            "required": true
          },
          {
            "label": "卡号",
