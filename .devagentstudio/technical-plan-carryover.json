          "access_card_claim_application"
        ],
        "base_path": "/api/access-card-claim-applications",
        "authentication": {
          "required": false
        },
        "schemas": {
          "AccessCardClaimApplicationItem": {
            "type": "object",
            "description": "门禁卡领用申请明细，用于领用页表格展示。",
            "properties": {
              "id": {
                "type": "string",
                "description": "申请明细记录标识，取自实体主键。"
              },
              "employeeName": {
                "type": "string",
                "description": "员工姓名。",
                "entity_field_ref": "access_card_claim_application.employee_name"
              },
              "employeeNo": {
                "type": "string",
                "description": "员工编号。",
                "entity_field_ref": "access_card_claim_application.employee_no"
              },
              "cardNo": {
                "type": "string",
                "description": "门禁卡卡号。",
                "entity_field_ref": "access_card_claim_application.card_no"
              },
              "claimStatus": {
                "type": "string",
                "description": "领签状态，取值：待领签、已领签。",
                "enum": [
                  "待领签",
                  "已领签"
                ],
                "entity_field_ref": "access_card_claim_application.claim_status"
              }
            },
            "required": [
              "id",
              "employeeName",
              "employeeNo",
              "cardNo",
              "claimStatus"
            ]
          },
          "AccessCardClaimApplicationPage": {
            "type": "object",
            "description": "待领签申请明细分页结果。",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "description": "总记录数。"
              },
              "pageSize": {
                "type": "integer",
                "minimum": 1,
                "description": "每页条数。"
              },
              "current": {
                "type": "integer",
                "minimum": 1,
                "description": "当前页码。"
              },
              "list": {
                "type": "array",
                "description": "当前页申请明细列表。",
                "items": {
                  "$ref": "AccessCardClaimApplicationItem"
                }
              }
            },
            "required": [
              "total",
              "pageSize",
              "current",
              "list"
            ]
          },
          "CompleteClaimRequest": {
            "type": "object",
            "description": "完成领签请求，提交勾选或全选的申请明细。",
            "properties": {
              "applicationIds": {
                "type": "array",
                "minimumItems": 1,
                "description": "需要完成领签的申请明细标识列表，来源于明细列表返回的 id。",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "applicationIds"
            ]
          },
          "CompleteClaimResult": {
            "type": "object",
            "description": "完成领签结果。",
            "properties": {
              "updatedCount": {
                "type": "integer",
                "minimum": 0,
                "description": "本次更新为已领签的申请明细条数。"
              },
              "applicationIds": {
                "type": "array",
                "description": "本次完成领签的申请明细标识列表。",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "updatedCount",
              "applicationIds"
            ]
          }
        },
        "endpoints": [
          {
            "id": "contract_access_card_claim_application.list",
            "name": "查询本人待领签申请明细",
