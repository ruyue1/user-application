            "name": "card_no",
            "type": "text",
            "required": true
          },
          {
            "label": "领签状态",
            "description": "该条申请明细的领签状态；进入页面时展示本人名下待领签的明细，完成领签后由待领签更新为已领签。",
            "name": "claim_status",
            "type": "enum",
            "required": true,
            "enum_values": [
              "待领签",
              "已领签"
            ]
          }
        ]
      },
      {
        "id": "access_card",
