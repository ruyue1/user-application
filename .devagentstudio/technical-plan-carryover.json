          {
            "label": "姓名",
            "description": "发起离职注销申请的员工姓名，来源于扫码识别后匹配的本人名下门禁卡信息。",
            "name": "employee_name",
            "type": "text",
            "required": true
          },
          {
            "label": "员工编号",
            "description": "发起离职注销申请的员工编号，来源于扫码识别后匹配的本人名下门禁卡信息。",
            "name": "employee_no",
            "type": "text",
            "required": true
          },
          {
            "label": "卡号",
            "description": "本次申请注销的门禁卡卡号。",
            "name": "card_no",
            "type": "text",
            "required": true
          },
          {
            "label": "申请注销",
            "description": "本次提交后将门禁卡申请注销字段更新为离职，表示员工已发起离职注销申请。",
            "name": "deactivation_apply",
            "type": "enum",
