              {
                "name": "current",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "当前页码。"
                }
              },
              {
                "name": "pageSize",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "每页条数。"
                }
              }
            ],
            "request_schema_ref": null,
            "response_schema_ref": "AccessCardClaimApplicationPage",
            "error_codes": [],
            "authentication": {
              "required": false
            }
          },
          {
            "id": "contract_access_card_claim_application.complete_claim",
            "name": "完成领签",
            "method": "POST",
            "path": "/api/access-card-claim-applications/complete-claim",
