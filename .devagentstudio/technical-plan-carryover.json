        "description": "员工持有的门禁卡记录，包含姓名、员工编号、卡号、权限状态与申请注销字段，用于归还页展示本人使用中的卡片并发起离职注销申请。",
        "fields": [
          {
            "label": "姓名",
            "description": "门禁卡持有员工的姓名，展示于归还页门禁卡信息表格。",
            "name": "employee_name",
            "type": "text",
            "required": true
          },
          {
            "label": "员工编号",
            "description": "门禁卡持有员工的员工编号，展示于归还页门禁卡信息表格。",
            "name": "employee_no",
            "type": "text",
            "required": true
          },
          {
            "label": "卡号",
            "description": "门禁卡的实体卡编号，展示于归还页门禁卡信息表格。",
            "name": "card_no",
            "type": "text",
            "required": true
          },
          {
            "label": "权限状态",
            "description": "门禁卡的权限状态，归还页仅展示本人名下为使用中的卡片。",
            "name": "permission_status",
            "type": "enum",
            "required": true,
            "enum_values": [
