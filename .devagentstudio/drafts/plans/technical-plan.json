{
  "artifact_type": "technical-plan",
  "architecture": {
    "frontend": "基于单页应用生成页面、路由和 API 客户端。",
    "backend": "后端技术栈固定为 Java8 + Springboot，提供真实 HTTP API、资源接口和业务契约实现。",
    "data": "数据库固定使用 MySQL8，缓存固定使用 Redis。"
  },
  "entities": [
    {
      "id": "personnel_detail",
      "name": "人员明细",
      "description": "记录人员的基本明细信息，用于在只读列表中分页查看。",
      "fields": [
        {
          "label": "姓名（唯一标识）",
          "description": "人员的姓名，用于在只读列表中标识每位人员，每条记录必须有值且在人员明细内保持唯一。",
          "name": "name",
          "type": "text",
          "required": true
        },
        {
          "label": "性别",
          "description": "人员的性别，从枚举值中选择，选填。",
          "name": "gender",
          "type": "enum",
          "required": false,
          "enum_values": [
            "男",
            "女"
          ]
        },
        {
          "label": "年龄",
          "description": "人员的年龄，整数，选填。",
          "name": "age",
          "type": "number",
          "required": false
        },
        {
          "label": "联系电话",
          "description": "人员的联系电话号码，选填。",
          "name": "phone",
          "type": "text",
          "required": false
        },
        {
          "label": "座机号",
          "description": "人员的座机号码，选填。",
          "name": "landline",
          "type": "text",
          "required": false
        },
        {
          "label": "电子邮箱",
          "description": "人员的电子邮箱地址，选填。",
          "name": "email",
          "type": "text",
          "required": false
        },
        {
          "label": "所属部门",
          "description": "人员所属的部门名称，选填。",
          "name": "department",
          "type": "text",
          "required": false
        },
        {
          "label": "职位",
          "description": "人员担任的职位名称，选填。",
          "name": "position",
          "type": "text",
          "required": false
        },
        {
          "label": "入职日期",
          "description": "人员的入职日期，选填。",
          "name": "entry_date",
          "type": "date",
          "required": false
        },
        {
          "label": "备注",
          "description": "关于该人员的补充备注信息，选填。",
          "name": "remark",
          "type": "long_text",
          "required": false
        }
      ]
    }
  ],
  "api_contracts": [
    {
      "id": "personnel_detail_contract",
      "name": "人员明细",
      "base_path": "/personnel-details",
      "authentication": {
        "required": false
      },
      "schemas": {
        "PageResult": {
          "type": "object",
          "description": "通用分页结果",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "总记录数"
            },
            "current": {
              "type": "integer",
              "minimum": 1,
              "description": "当前页码"
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "description": "每页条数"
            },
            "list": {
              "type": "array",
              "description": "当前页数据列表",
              "items": {
                "$ref": "PersonnelDetailListItem"
              }
            }
          },
          "required": []
        },
        "PersonnelDetailListItem": {
          "type": "object",
          "description": "人员明细列表项",
          "properties": {
            "name": {
              "type": "string",
              "description": "姓名"
            },
            "gender": {
              "type": "string",
              "enum": [
                "男",
                "女"
              ],
              "description": "性别"
            },
            "age": {
              "type": "integer",
              "minimum": 0,
              "description": "年龄"
            },
            "phone": {
              "type": "string",
              "description": "联系电话"
            },
            "landline": {
              "type": "string",
              "description": "座机号"
            },
            "email": {
              "type": "string",
              "description": "电子邮箱"
            },
            "department": {
              "type": "string",
              "description": "所属部门"
            },
            "position": {
              "type": "string",
              "description": "职位"
            },
            "entryDate": {
              "type": "string",
              "format": "date",
              "description": "入职日期"
            },
            "remark": {
              "type": "string",
              "description": "备注"
            }
          },
          "required": []
        }
      },
      "endpoints": [
        {
          "id": "personnel_detail_contract.listPersonnelDetails",
          "name": "分页查询人员明细",
          "method": "GET",
          "path": "/personnel-details",
          "summary": "分页查询人员明细列表，支持按页码和每页条数浏览；返回姓名、性别、年龄、联系电话、座机号、电子邮箱、所属部门、职位、入职日期和备注等明细信息。列表分页。",
          "parameters": [
            {
              "name": "current",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "minimum": 1,
                "default": 1,
                "description": "当前页码，默认1"
              }
            },
            {
              "name": "pageSize",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "minimum": 1,
                "default": 20,
                "description": "每页条数，默认20"
              }
            }
          ],
          "request_schema_ref": null,
          "response_schema_ref": "PageResult",
          "error_codes": [],
          "authentication": {
            "required": false
          }
        }
      ],
      "entity_ids": [
        "personnel_detail"
      ]
    },
    {
      "id": "react_string_contract",
      "name": "React前端编程字符串",
      "base_path": "/react-string",
      "authentication": {
        "required": false
      },
      "schemas": {
        "ReactStringContent": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "description": "后端接口返回的字符串内容「React前端编程！」。"
            }
          },
          "required": []
        }
      },
      "endpoints": [
        {
          "id": "react_string_contract.getReactString",
          "name": "获取React前端编程字符串",
          "method": "GET",
          "path": "/react-string/content",
          "summary": "获取后端返回的字符串内容「React前端编程！」，用于页面加载时直接展示；该接口为固定字符串读取，不做分页。",
          "parameters": [],
          "request_schema_ref": null,
          "response_schema_ref": "ReactStringContent",
          "error_codes": [],
          "authentication": {
            "required": false
          }
        }
      ],
      "entity_ids": []
    }
  ],
  "pages": [
    {
      "pageId": "personnel_detail_list",
      "references": {
        "endpoint_dependencies": [
          {
            "endpoint_id": "personnel_detail_contract.listPersonnelDetails",
            "usage": "初始加载与切换分页时读取人员明细分页数据，用于表格展示与当前分页位置",
            "trigger": "页面初始加载时读取第一页人员明细；使用者通过分页控件切换页码时按所选页码重新读取",
            "required_for_initial_load": true
          },
          {
            "endpoint_id": "react_string_contract.getReactString",
            "usage": "页面加载时读取固定字符串内容并在页面上展示",
            "trigger": "页面初始加载时读取固定字符串",
            "required_for_initial_load": true
          }
        ],
        "action_implementations": [
          {
            "actionId": "change_page",
            "endpointId": "personnel_detail_contract.listPersonnelDetails"
          }
        ]
      }
    },
    {
      "pageId": "react_string_display",
      "references": {
        "endpoint_dependencies": [
          {
            "endpoint_id": "react_string_contract.getReactString",
            "usage": "页面加载时获取后端返回的字符串内容「React前端编程！」，用于在页面上直接展示",
            "trigger": "初始加载页面时触发；页面刷新或重新进入页面时再次触发",
            "required_for_initial_load": true
          }
        ],
        "action_implementations": [
          {
            "actionId": "load_string",
            "endpointId": "react_string_contract.getReactString"
          }
        ]
      }
    }
  ],
