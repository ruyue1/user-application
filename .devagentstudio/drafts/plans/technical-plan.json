{
  "artifact_type": "technical-plan",
  "architecture": {
    "frontend": "基于单页应用生成页面、路由和 API 客户端。",
    "backend": "后端技术栈固定为 Java8 + Springboot，提供真实 HTTP API、资源接口和业务契约实现。",
    "data": "数据库固定使用 MySQL8，缓存固定使用 Redis。"
  },
  "entities": [
    {
      "id": "personnel_detail",
      "name": "人员明细",
      "description": "记录人员的基本明细信息（含座机号），用于在只读列表中分页查看。",
      "fields": [
        {
          "label": "姓名（唯一标识）",
          "description": "人员的姓名，作为人员明细记录的唯一业务标识，每条记录必须有值且在当前实体内保持唯一。",
          "name": "name",
          "type": "text",
          "required": true
        },
        {
          "label": "性别",
          "description": "人员的性别，从枚举值中选择。",
          "name": "gender",
          "type": "enum",
          "required": false,
          "enum_values": [
            "男",
            "女"
          ]
        },
        {
          "label": "年龄",
          "description": "人员的年龄，以整数表示，应为正整数。",
          "name": "age",
          "type": "number",
          "required": false
        },
        {
          "label": "联系电话",
          "description": "人员的联系电话号码。",
          "name": "phone",
          "type": "text",
          "required": false
        },
        {
          "label": "座机号",
          "description": "人员的座机号码，用于补充联系方式的固定电话信息。",
          "name": "landline",
          "type": "text",
          "required": false
        },
        {
          "label": "电子邮箱",
          "description": "人员的电子邮箱地址。",
          "name": "email",
          "type": "text",
          "required": false
        },
        {
          "label": "所属部门",
          "description": "人员所属的部门名称。",
          "name": "department",
          "type": "text",
          "required": false
        },
        {
          "label": "职位",
          "description": "人员在所属部门担任的职位。",
          "name": "position",
          "type": "text",
          "required": false
        },
        {
          "label": "入职日期",
          "description": "人员的入职日期，精确到日。",
          "name": "entry_date",
          "type": "date",
          "required": false
        },
        {
          "label": "备注",
          "description": "关于该人员的补充说明信息。",
          "name": "remark",
          "type": "long_text",
          "required": false
        }
      ]
    }
  ],
  "api_contracts": [
    {
      "id": "personnel_detail_contract",
      "name": "人员明细",
      "base_path": "/personnel-details",
      "authentication": {
        "required": false
      },
      "schemas": {
        "PageResult": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "总记录数"
            },
            "current": {
              "type": "integer",
              "minimum": 1,
              "description": "当前页码"
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "description": "每页条数"
            },
            "list": {
              "type": "array",
              "items": {
                "$ref": "PersonnelDetailListItem"
              },
              "description": "当前页人员明细记录列表"
            }
          },
          "required": []
        },
        "PersonnelDetailListItem": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "姓名，人员的唯一业务标识"
            },
            "gender": {
              "type": "string",
              "enum": [
                "男",
                "女"
              ],
              "description": "性别"
            },
            "age": {
              "type": "integer",
              "minimum": 1,
              "description": "年龄，正整数"
            },
            "phone": {
              "type": "string",
              "description": "联系电话号码"
            },
            "landline": {
              "type": "string",
              "description": "座机号码"
            },
            "email": {
              "type": "string",
              "description": "电子邮箱地址"
            },
            "department": {
              "type": "string",
              "description": "所属部门名称"
            },
            "position": {
              "type": "string",
              "description": "职位"
            },
            "entryDate": {
              "type": "string",
              "format": "date",
              "description": "入职日期"
            },
            "remark": {
              "type": "string",
              "description": "备注信息"
            }
          },
          "required": []
        }
      },
      "endpoints": [
        {
          "id": "personnel_detail_contract.listPersonnelDetails",
          "name": "分页查询人员明细",
          "method": "GET",
          "path": "/personnel-details",
          "summary": "分页查询人员明细列表，支持按页码和每页条数浏览；返回姓名、性别、年龄、联系电话、座机号、电子邮箱、所属部门、职位、入职日期和备注等明细信息。列表分页。",
          "parameters": [
            {
              "name": "current",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "minimum": 1,
                "default": 1,
                "description": "当前页码"
              }
            },
            {
              "name": "pageSize",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "minimum": 1,
                "default": 20,
                "description": "每页条数"
              }
            }
          ],
          "request_schema_ref": null,
          "response_schema_ref": "PageResult",
          "error_codes": [
            "INVALID_PARAMETER"
          ],
          "authentication": {
            "required": false
          }
        }
      ],
      "entity_ids": [
        "personnel_detail"
      ]
    },
    {
      "id": "greeting_contract",
      "name": "问候语",
      "base_path": "/greeting",
      "authentication": {
        "required": false
      },
      "schemas": {
        "GreetingResult": {
          "type": "object",
          "properties": {
            "greeting": {
              "type": "string",
              "description": "接口返回的问候语字符串，固定为「晚上好！」"
            }
          },
          "required": [
            "greeting"
          ]
        }
      },
      "endpoints": [
        {
          "id": "greeting_contract.getGreeting",
          "name": "获取问候语",
          "method": "GET",
          "path": "/greeting",
          "summary": "获取问候语字符串，返回「晚上好！」用于问候语展示页直接以文本形式展示。",
          "parameters": [],
          "request_schema_ref": null,
          "response_schema_ref": "GreetingResult",
          "error_codes": [],
          "authentication": {
            "required": false
          }
        }
      ],
      "entity_ids": []
    }
  ],
  "pages": [
    {
      "pageId": "personnel_detail_list",
      "references": {
        "endpoint_dependencies": [
          {
            "endpoint_id": "personnel_detail_contract.listPersonnelDetails",
            "usage": "分页查询人员明细列表，用于页面初始加载展示人员明细表格及分页位置，并在使用者切换页码时读取对应页数据。",
            "trigger": "页面初始加载时读取第一页人员明细；使用者在分页控件切换页码时刷新对应页人员明细。",
            "required_for_initial_load": true
          }
        ],
        "action_implementations": [
          {
            "actionId": "change_page",
            "endpointId": "personnel_detail_contract.listPersonnelDetails"
          }
        ]
      }
    },
    {
      "pageId": "greeting_display_page",
      "references": {
        "endpoint_dependencies": [
          {
            "endpoint_id": "greeting_contract.getGreeting",
            "usage": "页面加载时获取接口返回的问候语字符串「晚上好！」并直接以文本形式展示。",
            "trigger": "页面初始加载时调用接口获取问候语字符串。",
            "required_for_initial_load": true
          }
        ],
        "action_implementations": [
          {
            "actionId": "load_greeting",
            "endpointId": "greeting_contract.getGreeting"
          }
        ]
      }
    }
  ],
