"--- a/frontend/src/pages/Greeting/index.tsx\n+++ b/frontend/src/pages/Greeting/index.tsx\n@@ -0,0 +1,33 @@\n+import type { FC } from 'react';\n+import { Typography } from 'antd';\n+import { ProCard } from '@ant-design/pro-components';\n+\n+/**\n+ * 欢迎展示页（Greeting）\n+ *\n+ * 纯展示页面：加载后直接呈现固定文本 '欢迎!'，\n+ * 不调用任何业务接口，也不涉及权限、跳转与状态绑定。\n+ * 侧边导航切换由平台布局与路由提供，页面内部不包含交互控件。\n+ */\n+const Greeting: FC = () => {\n+  return (\n+    <div style={{ padding: 24 }}>\n+      <ProCard\n+        bordered\n+        style={{ maxWidth: 720, margin: '0 auto' }}\n+        bodyStyle={{ padding: 48, textAlign: 'center' }}\n+      >\n+        <Typography.Title\n+          level={2}\n+          data-information-item-id='greeting_text'\n+          data-control-id='greeting_text-display'\n+          style={{ margin: 0 }}\n+        >\n+          欢迎!\n+        </Typography.Title>\n+      </ProCard>\n+    </div>\n+  );\n+};\n+\n+export default Greeting;\n"