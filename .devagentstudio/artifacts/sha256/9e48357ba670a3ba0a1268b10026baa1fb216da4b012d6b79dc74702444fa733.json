"--- a/frontend/src/pages/HelloWorld/index.tsx\n+++ b/frontend/src/pages/HelloWorld/index.tsx\n@@ -0,0 +1,17 @@\n+import { ProCard } from '@ant-design/pro-components';\n+\n+/**\n+ * Hello World 展示页\n+ *\n+ * 纯静态展示页面：主内容区固定展示字符串 hello world，\n+ * 不调用任何后端接口，不包含按钮、链接、表单与权限判断。\n+ */\n+export default function HelloWorld() {\n+  return (\n+    <ProCard bordered>\n+      <div className='flex items-center justify-center py-16'>\n+        <p className='text-2xl font-semibold text-gray-800'>hello world</p>\n+      </div>\n+    </ProCard>\n+  );\n+}\n"