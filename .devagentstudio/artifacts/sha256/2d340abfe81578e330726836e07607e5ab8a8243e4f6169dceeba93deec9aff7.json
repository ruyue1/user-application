"--- a/frontend/src/pages/HelloWorld/index.tsx\n+++ b/frontend/src/pages/HelloWorld/index.tsx\n@@ -0,0 +1,32 @@\n+import type { FC } from 'react';\n+import { Typography } from 'antd';\n+import { ProCard } from '@ant-design/pro-components';\n+\n+/**\n+ * HelloWorld 展示页\n+ *\n+ * 纯展示页面：加载后直接呈现固定文本 'hello world'，\n+ * 不调用任何业务接口，也不涉及权限、跳转与状态绑定。\n+ */\n+const HelloWorld: FC = () => {\n+  return (\n+    <div style={{ padding: 24 }}>\n+      <ProCard\n+        bordered\n+        style={{ maxWidth: 720, margin: '0 auto' }}\n+        bodyStyle={{ padding: 48, textAlign: 'center' }}\n+      >\n+        <Typography.Title\n+          level={2}\n+          data-information-item-id='hello_world_text'\n+          data-control-id='hello_world_text-display'\n+          style={{ margin: 0 }}\n+        >\n+          hello world\n+        </Typography.Title>\n+      </ProCard>\n+    </div>\n+  );\n+};\n+\n+export default HelloWorld;\n"