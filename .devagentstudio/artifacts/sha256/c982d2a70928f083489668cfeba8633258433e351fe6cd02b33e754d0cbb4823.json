"--- a/frontend/src/apis/greetingApi.ts\n+++ b/frontend/src/apis/greetingApi.ts\n@@ -0,0 +1,23 @@\n+/**\n+ * 问候语业务接口定义\n+ * API Contract: greeting (base_path: /api/hi)\n+ */\n+\n+import service from \"./service\";\n+\n+/** GET /api/hi 的响应业务类型 */\n+export interface GreetingResponse {\n+  /** 问候语内容，固定为\"欢迎来到我的世界！\" */\n+  content: string;\n+}\n+\n+/**\n+ * 获取问候语\n+ * GET /api/hi\n+ * 无请求参数，返回问候语内容。\n+ */\n+export async function getGreeting(): Promise<GreetingResponse> {\n+  return service.get<GreetingResponse>(\"/api/hi\");\n+}\n+\n+export default getGreeting;\n"