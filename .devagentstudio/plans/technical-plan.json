            "required_for_initial_load": true
          },
          {
            "endpoint_id": "product_api.detail",
            "usage": "action_trigger",
            "trigger": "点击列表中的商品查看详情时",
            "required_for_initial_load": false
          }
        ],
        "action_implementations": [
          {
            "actionId": "search_product",
