      "endpoints": [
        {
          "id": "product_api.list",
          "name": "查询商品列表",
          "method": "GET",
          "path": "/api/products",
          "summary": "按分页条件、商品名称关键词、分类和状态筛选查询商品列表。",
          "parameters": [
            {
              "name": "current",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "default": 1
              }
            },
            {
              "name": "pageSize",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "default": 20
              }
            },
            {
              "name": "keyword",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "category",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "status",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "enum": [
                  "on_shelf",
                  "off_shelf"
                ]
              }
            }
          ],
          "request_schema_ref": null,
          "response_schema_ref": "ProductListOutput",
          "error_codes": [
            "INTERNAL_ERROR"
          ],
          "authentication": {
            "required": false
          }
        },
        {
          "id": "product_api.detail",
          "name": "查询商品详情",
          "method": "GET",
          "path": "/api/products/{productId}",
          "summary": "根据商品ID查询商品的完整详细信息。",
          "parameters": [
            {
              "name": "productId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "request_schema_ref": null,
          "response_schema_ref": "ProductDetailOutput",
          "error_codes": [
            "NOT_FOUND",
            "INTERNAL_ERROR"
          ],
          "authentication": {
            "required": false
          }
        },
        {
          "id": "product_api.create",
          "name": "新增商品",
          "method": "POST",
          "path": "/api/products",
          "summary": "提交商品信息创建新商品，返回创建后的商品完整信息。",
          "parameters": [],
          "request_schema_ref": "ProductCreateInput",
          "response_schema_ref": "ProductCreateOutput",
          "error_codes": [
            "VALIDATION_ERROR",
            "INTERNAL_ERROR"
          ],
          "authentication": {
            "required": false
          }
        }
      ]
    }
  ],
  "pages": [
