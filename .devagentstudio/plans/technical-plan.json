{
  "artifact_type": "technical-plan",
  "architecture": {
    "frontend": "React 单页管理客户端采用 PC 端侧边栏导航布局，页头启用、页脚禁用，通过 REST 接口与后端交换 JSON 数据。",
    "backend": "后端技术栈固定为 Java8 + Springboot，提供真实 HTTP API、资源接口和业务契约实现。",
    "data": "数据库固定使用 MySQL8，缓存固定使用 Redis。"
  },
  "entities": [
    {
      "id": "Product",
      "name": "商品",
      "description": "记录商品的基础信息，包括名称、编码、分类、状态和说明等。",
      "fields": [
        {
          "label": "商品ID",
          "description": "商品的唯一标识。",
          "name": "product_id",
          "type": "text",
          "required": true
        },
        {
          "label": "商品名称",
          "description": "商品的名称，用于搜索和列表展示。",
          "name": "product_name",
          "type": "text",
          "required": true
        },
        {
          "label": "商品编码",
          "description": "商品的唯一编码，用于业务识别。",
          "name": "product_code",
          "type": "text",
          "required": true
        },
        {
          "label": "所属分类",
          "description": "商品所属的分类名称。",
          "name": "category",
          "type": "text",
          "required": true
        },
        {
          "label": "商品状态",
          "description": "商品的上下架状态。",
          "name": "status",
          "type": "enum",
          "required": true
        },
        {
          "label": "商品说明",
          "description": "商品的详细说明文本。",
          "name": "description",
          "type": "long_text",
          "required": false
        },
        {
          "label": "创建时间",
          "description": "商品记录的创建时间。",
          "name": "created_at",
          "type": "datetime",
          "required": true
        },
        {
          "label": "更新时间",
          "description": "商品记录的最近更新时间。",
          "name": "updated_at",
          "type": "datetime",
          "required": true
        }
      ]
    }
  ],
