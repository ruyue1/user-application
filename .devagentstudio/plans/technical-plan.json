          },
          {
            "actionId": "filter_by_category",
            "endpointId": "product_api.list"
          },
          {
            "actionId": "filter_by_status",
            "endpointId": "product_api.list"
          }
        ]
      }
    },
    {
      "pageId": "product_create",
      "references": {
        "endpoint_dependencies": [
          {
            "endpoint_id": "product_api.create",
            "usage": "action_trigger",
            "trigger": "点击提交按钮提交商品新增表单时",
            "required_for_initial_load": false
          }
        ],
        "action_implementations": [
          {
            "actionId": "submit_product_form",
            "endpointId": "product_api.create"
          }
        ]
      }
    }
