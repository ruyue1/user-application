          "type": "integer",
          "minimum": 1,
          "description": "当前页码，从 1 开始。"
        }
      },
      {
        "name": "pageSize",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "description": "每页记录数。"
        }
      }
    ],
    "request_schema_ref": null,
    "response_schema_ref": "AccessCardApplicationPage",
    "error_codes": [
      "INVALID_PARAMETER"
    ],
    "authentication": {
      "required": false
    }
