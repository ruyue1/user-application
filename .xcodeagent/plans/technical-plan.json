            },
            "studentId": {
              "type": "string",
              "description": "学生学号",
              "entity_field_ref": "SurveySubmission.student_id"
            },
            "major": {
              "type": "string",
              "description": "学生专业",
              "entity_field_ref": "SurveySubmission.major"
            },
            "grade": {
              "type": "string",
              "description": "学生年级",
              "enum": [
                "大一",
                "大二",
                "大三",
                "大四",
                "研究生"
              ],
              "entity_field_ref": "SurveySubmission.grade"
            },
            "careerDirection": {
              "type": "string",
              "description": "期望职业方向",
              "entity_field_ref": "SurveySubmission.career_direction"
            },
            "targetIndustry": {
              "type": "string",
              "description": "目标行业",
              "entity_field_ref": "SurveySubmission.target_industry"
            },
            "targetPosition": {
              "type": "string",
              "description": "目标岗位",
              "entity_field_ref": "SurveySubmission.target_position"
            },
            "professionalSkills": {
              "type": "string",
              "description": "专业技能评估",
              "entity_field_ref": "SurveySubmission.professional_skills"
            },
            "softSkills": {
              "type": "string",
              "description": "软实力评估",
              "entity_field_ref": "SurveySubmission.soft_skills"
            },
            "interests": {
              "type": "string",
              "description": "兴趣特长",
              "entity_field_ref": "SurveySubmission.interests"
            },
            "inSchoolPlan": {
              "type": "string",
              "description": "在校期间发展计划",
              "entity_field_ref": "SurveySubmission.in_school_plan"
            },
            "postGraduationPlan": {
              "type": "string",
              "description": "毕业后发展计划",
              "entity_field_ref": "SurveySubmission.post_graduation_plan"
            },
            "timeline": {
              "type": "string",
              "description": "时间安排",
              "entity_field_ref": "SurveySubmission.timeline"
            }
          },
          "required": [
            "studentName",
            "studentId",
            "major",
            "grade",
            "careerDirection",
            "targetIndustry",
            "targetPosition",
            "professionalSkills",
            "softSkills",
            "interests",
            "inSchoolPlan",
            "postGraduationPlan",
            "timeline"
          ]
        },
        "SurveySubmissionOutput": {
          "type": "object",
          "properties": {
            "submissionId": {
              "type": "string",
              "description": "问卷提交记录的唯一标识"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time",
              "description": "问卷提交时间",
              "entity_field_ref": "SurveySubmission.submitted_at"
            },
            "message": {
              "type": "string",
              "description": "提交成功反馈信息，告知学生问卷已提交完成"
            }
          },
          "required": [
            "submissionId",
            "submittedAt",
            "message"
          ]
        }
      },
      "endpoints": [
        {
          "id": "survey_api.get_info",
          "method": "GET",
          "path": "/api/survey/info",
          "summary": "获取调查问卷的标题、目的与填写入口指引信息，用于首页展示",
          "parameters": [],
          "request_schema_ref": null,
          "response_schema_ref": "SurveyInfoOutput",
          "error_codes": [
            "UNAUTHORIZED",
            "INTERNAL_ERROR"
          ],
          "authentication": {
            "required": true
          }
        },
        {
          "id": "survey_api.submit",
          "method": "POST",
          "path": "/api/survey/submissions",
          "summary": "提交学生填写的职业发展规划调查问卷，服务端校验必填字段后持久化并返回成功反馈",
          "parameters": [],
          "request_schema_ref": "SurveySubmissionInput",
          "response_schema_ref": "SurveySubmissionOutput",
          "error_codes": [
            "UNAUTHORIZED",
            "VALIDATION_ERROR",
            "INTERNAL_ERROR"
          ],
          "authentication": {
            "required": true
          }
        }
      ]
    }
