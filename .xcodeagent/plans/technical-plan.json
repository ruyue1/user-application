  "api_contracts": [
    {
      "id": "survey_api",
      "entity_ids": [
        "SurveySubmission"
      ],
      "base_path": "/api/survey",
      "authentication": {
        "required": true
      },
      "schemas": {
        "SurveyInfoOutput": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "调查问卷的标题，让学生明确当前问卷主题为大学生职业发展规划调查"
            },
            "purpose": {
              "type": "string",
              "description": "问卷目的说明，帮助学生认识填写问卷的意义"
            },
            "entryGuide": {
              "type": "string",
              "description": "填写入口指引，提示学生点击入口按钮进入问卷填写页面"
            }
          },
          "required": [
            "title",
            "purpose",
            "entryGuide"
          ]
        },
        "SurveySubmissionInput": {
          "type": "object",
          "properties": {
            "studentName": {
              "type": "string",
              "description": "学生姓名",
